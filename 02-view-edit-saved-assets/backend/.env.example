# Copy to backend/.env for local development. Every value is optional locally.

DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite. For PostgreSQL:
# DATABASE_URL=postgres://digiwill:digiwill@localhost:5432/digiwill

# Where the React app runs — used for links inside emails.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Emails print to the terminal by default. For real delivery (e.g. Gmail SMTP with an app password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=DigiWill BD <you@gmail.com>

# Protects POST /api/switch/run/ for an external scheduler.
# CRON_SECRET=another-long-random-string

# Dead Man's Switch tuning
# SWITCH_HEADS_UP_DAYS=3
# SWITCH_REMINDER_EVERY_DAYS=2
